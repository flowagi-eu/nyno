de-heading bde-heading-8056-103\">\nMás de 8 millones de Check-ins  enviados a las autoridades\n</h2><div class=\"bde-text-8056-104-8056-1 bde-text bde-text-8056-104\">\nExpertos en registro de huéspedes, ¿a qué esperas?\n</div>\n</div><div class=\"bde-div-8056-105-8056-1 bde-div bde-div-8056-105\">\n  \n  \n\t\n\n\n\n<div class=\"bde-code-block-8056-106-8056-1 bde-code-block bde-code-block-8056-106\">\n\n\n\n</div><style>@media (max-width:767px){.breakdance .bde-form-builder-8056-107-8056-1 .breakdance-form{grid-template-columns:unset}.breakdance .bde-form-builder-8056-107-8056-1 .breakdance-form--horizontal{grid-auto-flow:unset}.breakdance .bde-form-builder-8056-107-8056-1 .breakdance-form .breakdance-form-field,.breakdance .bde-form-builder-8056-107-8056-1 .breakdance-form .breakdance-form-stepper{grid-column-start:unset}}</style><div id=\"rgratis_banner_es\" class=\"bde-form-builder-8056-107-8056-1 bde-form-builder bde-form-builder-8056-107\">\n\n\n<form id=\"rgratis_banner_es\" class=\"breakdance-form breakdance-form--horizontal\" data-options=\"{&quot;slug&quot;:&quot;custom&quot;,&quot;name&quot;:&quot;Registro Gratis - ES&quot;,&quot;ajaxUrl&quot;:&quot;https:\\/\\/www.checkinscan.com\\/wp-admin\\/admin-ajax.php&quot;,&quot;clearOnSuccess&quot;:true,&quot;hideOnSuccess&quot;:false,&quot;successMessage&quot;:&quot;The form was submitted successfully.&quot;,&quot;errorMessage&quot;:&quot;Something went wrong.&quot;,&quot;redirect&quot;:false,&quot;redirectUrl&quot;:&quot;https:\\/\\/app.checkinscan.com\\/registro?utm_source={test}&amp;utm_medium={utm_medium}&amp;utm_campaign={utm_campaign}&amp;user_email={correo_electronico}&quot;,&quot;customJavaScript&quot;:{&quot;js_on_success&quot;:&quot;const url = window.location.search;\\nconst urlParams = new URLSearchParams(url);\\n\\nconst utm_source = urlParams.get(&#039;utm_source&#039;) ? urlParams.get(&#039;utm_source&#039;) : \\&quot;\\&quot;;\\nconst utm_medium = urlParams.get(&#039;utm_medium&#039;) ? urlParams.get(&#039;utm_medium&#039;) : \\&quot;\\&quot;;\\nconst utm_campaign = urlParams.get(&#039;utm_campaign&#039;) ? urlParams.get(&#039;utm_campaign&#039;) : \\&quot;\\&quot;;\\nconst utm_content = urlParams.get(&#039;utm_content&#039;) ? urlParams.get(&#039;utm_content&#039;) : \\&quot;\\&quot;;\\n\\nwindow.location.href = \\&quot;https:\\/\\/app.checkinscan.com\\/registro?utm_source=\\&quot; +utm_source+\\&quot;&amp;utm_medium=\\&quot;+utm_medium+\\&quot;&amp;utm_campaign=\\&quot;+utm_campaign+\\&quot;&amp;utm_content=\\&quot;+utm_content+\\&quot;&amp;user_email=\\&quot;+encodeURIComponent(document.getElementById(&#039;correo_electronico2&#039;).value);&quot;},&quot;recaptcha&quot;:{&quot;key&quot;:&quot;6LfQSNMrAAAAABU6Q2MeSTJaGYCIXbthJBfvORW1&quot;,&quot;enabled&quot;:true},&quot;honeypot_enabled&quot;:true,&quot;popupsOnSuccess&quot;:[],&quot;popupsOnError&quot;:[]}\" data-steps=\"0\" >\n  \n  \n  \n<div class=\"breakdance-form-field breakdance-form-field--email\" >\n    \n    \n            <label class=\"breakdance-form-field__label\" for=\"correo_electronico2\">\n            Correo electrónico<span class=\"breakdance-form-field__required\">*</span>\n        </label>\n    \n    <input\n    class=\"breakdance-form-field__input\"\n    id=\"correo_electronico2\"\n    aria-describedby=\"correo_electronico2\"\n    type=\"email\"\n    name=\"fields[correo_electronico2]\"\n    placeholder=\"Introduce tu email...\"\n    value=\"\"\n                \n        \n        \n    required\n    \n    \n    \n>\n\n\n    \n    \n</div>\n\n\n<div class=\"breakdance-form-field breakdance-form-field--hidden\" >\n    \n    \n    \n    <input\n    id=\"utm_source\"\n    type=\"hidden\"\n    name=\"fields[utm_source]\"\n    value=\"\"\n    >\n\n\n    \n    \n</div>\n\n\n<div class=\"breakdance-form-field breakdance-form-field--hidden\" >\n    \n    \n    \n    <input\n    id=\"utm_medium\"\n    type=\"hidden\"\n    name=\"fields[utm_medium]\"\n    value=\"\"\n    >\n\n\n    \n    \n</