www.checkinscan.com/wp-content/uploads/rural_accommodation-1.svg\" width=\"30\" >\n                  </span>\n      \n      <span class=\"breakdance-dropdown-link__label\">\n                  <span class=\"breakdance-dropdown-link__text\">Alojamiento Rural</span>\n        \n                  <span class=\"breakdance-dropdown-link__description\"><div style=\"color:grey; font-size:12px;font-weight:400;\">¿No tienes cobertura? Haz el check-in offline sin problemas.</div></span>\n              </span>\n        </a>\n\n  </li>\n\n                                <li class=\"breakdance-dropdown-item\">\n            \n            \n            \n\n    \n    \n              \n    \n    \n    <a class=\"breakdance-link breakdance-dropdown-link\" href=\"/soluciones-check-in-para-albergues-hostels/\" target=\"_self\" data-type=\"url\"  id=\"menu_caravana\" >\n\n              <span class=\"breakdance-dropdown-link__icon\">\n                      <img src=\"https://www.checkinscan.com/wp-content/uploads/rural_hostel.svg\" width=\"30\" >\n                  </span>\n      \n      <span class=\"breakdance-dropdown-link__label\">\n                  <span class=\"breakdance-dropdown-link__text\">Albergue / Hostel</span>\n        \n                  <span class=\"breakdance-dropdown-link__description\"><div style=\"color:grey; font-size:12px;font-weight:400;\">Optimiza el tiempo y agiliza el proceso de check-in</div></span>\n              </span>\n        </a>\n\n  </li>\n\n                      </ul>\n        </div>\n              <div class=\"breakdance-dropdown-column \">\n          \n          <ul class=\"breakdance-dropdown-links\">\n                                <li class=\"breakdance-dropdown-item\">\n            \n            \n            \n\n    \n    \n              \n    \n    \n    <a class=\"breakdance-link breakdance-dropdown-link\" href=\"/soluciones-check-in-para-viviendas-turisticas/\" target=\"_self\" data-type=\"url\"  id=\"menu_complejo\" >\n\n              <span