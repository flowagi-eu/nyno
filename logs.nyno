nce-menu-topbar-logo\" href=\"/\">\n                                  </a>\n    \n              <button class=\"breakdance-menu-close-button\" type=\"button\">Close</button>\n          </li>\n  \n    <li class=\"bde-menu-dropdown-516-127 bde-menu-dropdown breakdance-menu-item\">\n<div class=\"breakdance-dropdown breakdance-dropdown--custom \">\n    <div class=\"breakdance-dropdown-toggle\">\n            \n              <button class=\"breakdance-menu-link\" type=\"button\" aria-expanded=\"false\" aria-controls=\"dropdown-127\" >\n          Soluciones para Alojamientos\n        </button>\n      \n      <button class=\"breakdance-menu-link-arrow\" type=\"button\" aria-expanded=\"false\" aria-controls=\"dropdown-127\" aria-label=\"Soluciones para Alojamientos Submenu\"></button>\n    </div>\n\n    <div class=\"breakdance-dropdown-floater\" aria-hidden=\"true\" id=\"dropdown-127\">\n        <div class=\"breakdance-dropdown-body\">\n              <div class=\"breakdance-dropdown-section breakdance-dropdown-section--\">\n    <div class=\"breakdance-dropdown-columns\">\n              <div class=\"breakdance-dropdown-column \">\n          \n          <ul class=\"breakdance-dropdown-links\">\n                                <li class=\"breakdance-dropdown-item\">\n            \n            \n            \n\n    \n    \n              \n    \n    \n    <a class=\"breakdance-link breakdance-dropdown-link\" href=\"/soluciones-check-in-para-hoteles/\" target=\"_self\" data-type=\"url\"  id=\"menu_hotel\" >\n\n              <span class=\"breakdance-dropdown-link__icon\">\n                      <img src=\"https://www.checkinscan.com/wp-content/uploads/Frame.svg\" width=\"30\" alt=\"Check-in Hotel\">\n                  </span>\n      \n      <span class=\"breakdance-dropdown-link__label\">\n                  <span class=\"breakdance-dropdown-link__text\">Hotel</span>\n        \n                  <span class=\"breakdance-dropdown-link__description\"><div style=\"color:grey; font-size:12px;font-weight:400;\">Integración con los principales PMS y Channel Manager.</div></span>\n              </span>\n        </a>\n\n  </li>\n\n                                <li class=\"breakdance-dropdown-item\">\n            \n            \n            \n\n    \n    \n              \n    \n    \n    <a class=\"breakdance-link breakdance-dropdown-link\" href=\"/soluciones-check-in-para-hostales/\" target=\"_self\" data-type=\"url\"  id=\"menu_hostal\" >\n\n              <span class=\"breakdance-dropdown-link__icon\">\n                      <img src=\"https://www.checkinscan.com/wp-content/uploads/Frame-1.svg\" width=\"30\" alt=\"Check-in Hostal\">\n                  </span>\n      \n      <span class=\"breakdance-dropdown-link__label\">\n                  <span class=\"breakdance-dropdown-link__text\">Hostal</span>\n        \n                  <span class=\"breakdance-dropdown-link__description\"><div style=\"color:grey; font-size:12px;font-weight:400;\">Registra de forma fácil y rápida a los huéspedes de tu hostal.</div></span>\n              </span>\n        </a>\n\n  </li>\n\n                                <li class=\"breakdance-dropdown-item\">\n            \n            \n            \n\n    \n    \n              \n    \n    \n    <a class=\"breakdance-link breakdance-dropdown-link\" href=\"/soluciones-check-in-para-viviendas-turisticas/\" target=\"_self\" data-type=\"url\"  id=\"menu_vivienda_turistica\" >\n\n              <span class=\"breakdance-dropdown-link__icon\">\n                      <img src=\"https://www.checkinscan.com/wp-content/uploads/holiday_rental.svg\" width=\"30\" >\n                  </span>\n      \n      <span class=\"breakdance-dropdown-link__label\">\n                  <span class=\"breakdance-dropdown-link__text\">Vivienda Turística</span>\n        \n                  <span class=\"breakdance-dropdown-link__description\"><div style=\"color:grey; font-size:12px;font-weight:400;\">Check-in fácil que te permite separar por habitaciones.</div></span>\n              </span>\n        </a>\n\n  </li>\n\n                      </ul>\n        </div>\n              <div class=\"breakdance-dropdown-column \">\n          \n          <ul class=\"breakdance-dropdown-links\">\n                                <li class=\"breakdance-dropdown-item\">\n            \n            \n            \n\n    \n    \n              \n    \n    \n    <a class=\"breakdance-link breakdance-dropdown-link\" href=\"/soluciones-check-in-para-camping-area-camper/\" target=\"_self\" data-type=\"url\"  id=\"menu_camping\" >\n\n              <span class=\"breakdance-dropdown-link__icon\">\n                      <img src=\"https://www.checkinscan.com/wp-content/uploads/camping.svg\" width=\"30\" >\n                  </span>\n      \n      <span class=\"breakdance-dropdown-link__label\">\n                  <span class=\"breakdance-dropdown-link__text\">Camping / Área Camper</span>\n        \n                  <span class=\"breakdance-dropdown-link__description\"><div style=\"color:grey; font-size:12px;font-weight:400;\">Compatible con Campings, Áreas camper y Bungalows.</div></span>\n              </span>\n        </a>\n\n  </li>\n\n                                <li class=\"breakdance-dropdown-item\">\n            \n            \n            \n\n    \n    \n              \n    \n    \n    <a class=\"breakdance-link breakdance-dropdown-link\" href=\"/soluciones-check-in-para-alojamientos-rurales/\" target=\"_self\" data-type=\"url\"  id=\"menu_alojamiento_rural\" >\n\n              <span class=\"breakdance-dropdown-link__icon\">\n                      <img src=\"https://www.checkinscan.com/wp-content/uploads/rural_accommodation-1.svg\" width=\"30\" >\n                  </span>\n      \n      <span class=\"breakdance-dropdown-link__label\">\n                  <span class=\"breakdance-dropdown-link__text\">Alojamiento Rural</span>\n        \n                  <span class=\"breakdance-dropdown-link__description\"><div style=\"color:grey; font-size:12px;font-weight:400;\">¿No tienes cobertura? Haz el check-in offline sin problemas.</div></span>\n              </span>\n        </a>\n\n  </li>\n\n                                <li class=\"breakdance-dropdown-item\">\n            \n            \n            \n\n    \n    \n              \n    \n    \n    <a class=\"breakdance-link breakdance-dropdown-link\" href=\"/soluciones-check-in-para-albergues-hostels/\" target=\"_self\" data-type=\"url\"  id=\"menu_caravana\" >\n\n              <span class=\"breakdance-dropdown-link__icon\">\n                      <img src=\"https://www.checkinscan.com/wp-content/uploads/rural_hostel.svg\" width=\"30\" >\n                  </span>\n      \n      <span class=\"breakdance-dropdown-link__label\">\n                  <span class=\"breakdance-dropdown-link__text\">Albergue / Hostel</span>\n        \n                  <span class=\"breakdance-dropdown-link__description\"><div style=\"color:grey; font-size:12px;font-weight:400;\">Optimiza el tiempo y agiliza el proceso de check-in</div></span>\n              </span>\n        </a>\n\n  </li>\n\n                      </ul>\n        </div>\n              <div class=\"breakdance-dropdown-column \">\n          \n          <ul class=\"breakdance-dropdown-links\">\n                                <li class=\"breakdance-dropdown-item\">\n            \n            \n            \n\n    \n    \n              \n    \n    \n    <a class=\"breakdance-link breakdance-dropdown-link\" href=\"/soluciones-check-in-para-viviendas-turisticas/\" target=\"_self\" data-type=\"url\"  id=\"menu_complejo\" >\n\n              <span class=\"breakdance-dropdown-link__icon\">\n                      <img src=\"https://www.checkinscan.com/wp-content/uploads/complejo.svg\" width=\"30\" alt=\"complejo apartamentos turisticos icono\">\n                  </span>\n      \n      <span class=\"breakdance-dropdown-link__label\">\n                  <span class=\"breakdance-dropdown-link__text\">Complejo</span