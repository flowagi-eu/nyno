sotros. Más de 300 mil descargas de la aplicación en Google Play y App Store.\n</div>\n</div>\n</div>\n</div><div class=\"bde-div-22-1270 bde-div\">\n  \n  \n\t\n\n\n\n<div class=\"bde-div-22-1271 bde-div\">\n  \n  \n\t\n\n\n\n<div class=\"bde-div-22-1272 bde-div\">\n  \n  \n\t\n\n\n\n<div class=\"bde-icon-22-1273 bde-icon\">\n\n    \n            <div class=\"bde-icon-icon breakdance-icon-atom\" >\n    \n                    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" fill=\"none\">\r\n<path d=\"M15 0.5H45C53.0081 0.5 59.5 6.99187 59.5 15V45C59.5 53.0081 53.0081 59.5 45 59.5H15C6.99187 59.5 0.5 53.0081 0.5 45V15C0.5 6.99187 6.99187 0.5 15 0.5Z\" fill=\"#1D427B\" stroke=\"#1D427B\"/>\r\n<g clip-path=\"url(#clip0_10081_45)\">\r\n<path d=\"M9.05152 28.9782C9.12487 28.2869 9.50577 27.2908 9.85678 26.687C10.9516 24.8038 13.0428 23.7542 15.1967 23.8451C15.8631 14.5366 24.7438 8.20751 33.7298 10.4553C39.7631 11.9645 44.5037 17.5369 44.8548 23.8451C47.0087 23.7542 49.1 24.8038 50.1947 26.687C50.5457 27.2908 50.9267 28.2869 51 28.9782V33.8633C50.6268 36.0077 49.3301 37.8292 47.2739 38.5847C46.3335 38.9301 44.2368 39.0744 43.2619 38.9097C42.8688 38.8433 42.485 38.4321 42.3933 38.0487C42.0405 33.5193 42.5968 28.7377 42.3146 24.218C41.6914 14.2385 30.0276 9.13198 22.2856 15.4015C15.3838 20.9906 18.4201 29.9472 17.7395 37.634C17.7116 37.9485 17.5931 38.3558 17.3675 38.583C16.6474 39.3082 14.0248 38.9729 13.0859 38.6872C10.8712 38.013 9.44124 36.1269 9.05153 33.8633C9.17211 32.3067 8.8896 30.5045 9.05152 28.9782Z\" fill=\"white\"/>\r\n<path d=\"M28.123 44.6503C29.013 44.542 31.8134 44.5247 32.5882 44.8112C35.1123 45.7445 34.6196 49.6836 31.9544 49.9298C31.0419 50.0141 28.8265 50.0359 27.9432 49.9193C25.1496 49.5505 25.0146 45.0285 28.123 44.6503Z\" fill=\"white\"/>\r\n<path d=\"M16.0978 40.4873C16.5679 43.1751 18.6773 45.4878 21.2598 46.2415C21.5469 46.3253 22.2751 46.5316 22.5294 46.5316H24.3728C24.2909 47.0427 24.3347 47.5314 24.326